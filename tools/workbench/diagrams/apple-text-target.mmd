flowchart TD
    press["按下听写，记录原前台 PID"] --> audio["立即开始音频与识别；不等待 AX"]
    audio --> preview["按会话编号更新临时字幕"]
    audio --> final["松键后排空本轮音频并取得最终文字"]
    press --> captureReturn["Apple/Hex 开始可准备编辑器的目标捕获"]
    captureReturn --> worker["后台、可取消的 AX 目标捕获"]
    worker --> security["核对辅助功能权限与 Secure Event Input"]
    security --> focus["读取原 PID 的可编辑焦点与选区"]
    focus -->|可读| frozen["冻结进程、AX 元素与选区"]
    focus -->|焦点未暴露| eligible{"原 PID/AXFocusedWindow 未变；非安全输入；AXManualAccessibility 可写？"}
    eligible -->|否| noTarget["无文本目标；保留识别和音频"]
    eligible -->|是| enable["只对该 App root 设置一次 AXManualAccessibility"]
    enable --> poll["在同一 PID/原窗口内轮询焦点读取，最多 2 秒"]
    poll -->|可读且可编辑| frozen
    poll -->|超时、取消、Secure Input 或焦点变化| noTarget
    frozen --> deliver["最终句投递到本轮目标"]
    noTarget --> deliver
    final --> deliver
    deliver --> result{"目标捕获且仍与原 PID、焦点和选区匹配？"}
    result -->|否| pending["内存暂存这一句；用户可从托盘菜单显式复制"]
    result -->|是| insert["选定的单一原生传输只尝试一次"]
    insert -->|成功| cleanup["关闭 target 并释放 AX 引用"]
    insert -->|提交前目标变化| pending
    insert -->|提交状态不确定| uncertain["报告结果，不自动重试"]
    worker -->|听写取消或会话关闭| cancel["取消后台捕获；关闭迟到的 target"]
    observe["Doubao ObserveDictationSelection"] --> observeWorker["后台绑定原 PID；prepareEditor=false"]
    observeWorker --> readOnly["只读 Capture；不启用 AX"]
    recovery["通用 Capture / CaptureCurrentSelection"] --> readOnly
    readOnly --> fault["接收器身份故障时，只读更新同一 AX 字段与选区"]
    fault --> pendingRecovery["保存编辑位置与本 route 的轻量退役回执"]
    fault --> routeClose["原 route Close：复核强进程身份与 Core Audio 名单；晚退时有界重查"]
    routeClose -->|明确确认旧进程退役| retired["确认退役回执"]
    pendingRecovery --> replacement["准备新豆包会话：同时取得原选区与退役回执，复核新实例唯一且空闲"]
    retired --> replacement
    replacement --> recoveryFocus{"同一字段焦点仍有效？"}
    recoveryFocus -->|否| preserveFocus["焦点已变；保持现场并释放恢复目标"]
    recoveryFocus -->|是| inputSource{"用户仍选 Doubao？"}
    inputSource -->|是| reconnect["重连输入上下文，再查询控制服务"]
    inputSource -->|否| preserveSource["输入源已变；保持用户选择并释放恢复目标"]
    routeClose -->|身份仍不确定| cleanupPending["清理待处理；不改编辑器或输入源"]
    routeClose -->|进程仍存活且清理完成| dropSnapshot["释放保存的选区"]
