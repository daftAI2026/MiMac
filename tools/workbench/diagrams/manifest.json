      "internal/adapters/textoutput/native_darwin.go",
      "internal/adapters/applespeech/applespeech.go"
    ]
  },
  {
    "id": "voice-tool-selection",
    "title": "语音工具启用与选择",
    "summary": "多个语音工具可同时启用，Current 只选择一个工具提供当前语音映射；配置发现是可取消的一次性读取，选择切换会取消旧工具仍按住的动作。Core 当前不执行 app-scoped 快捷键。",
    "sourcePaths": [
      "cmd/mimac/voice_tools.go",
      "cmd/mimac/voice_binding.go",
