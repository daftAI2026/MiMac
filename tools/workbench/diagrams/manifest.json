      "internal/bridge/core.go",
      "internal/adapters/chatgpt/discovery.go",
      "internal/adapters/wetype/discovery.go"
    ]
  },
  {
    "id": "voice-presentation-boundary",
    "title": "语音状态与呈现边界",
    "summary": "当前状态文案与诊断直接投影 Core 的 session/token/phase，不维护第二状态机；既有权限、故障和切换状态优先。收音阶段不证明已有非零 PCM，结束阶段不证明目标已提交。虚线为尚未接入的电平通道、统一语音条与 Siri 渲染器。",
    "sourcePaths": [
      "cmd/mimac/voice_presentation.go",
      "cmd/mimac/coordinator.go",
      "cmd/mimac/device.go",
