      "internal/audiosession/runtime.go"
    ]
  },
  {
    "id": "power-quit-recovery",
    "title": "睡眠、关闭与恢复",
    "summary": "睡眠/锁屏先阻断输入再关闭设备与会话，恢复时仅尝试一次且不触发权限提示。关闭设置窗保留菜单栏宿主；退出时先完成音频清理，再关闭插件。",
    "sourcePaths": [
      "cmd/mimac/power.go",
      "cmd/mimac/remote.go",
      "cmd/mimac/main.go",
      "cmd/mimac/audio_sessions.go",
      "internal/pluginrt/runtime.go"
    ]
  }
]
