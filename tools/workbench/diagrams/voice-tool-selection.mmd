flowchart LR
    prefs["tools.json：Enabled 列表与单个 Current id"] --> loaded["可同时加载多个已启用适配器"]
    loaded --> discover["每次启用/刷新执行一次可取消发现"]
    discover --> sequence["sequence 检查丢弃过期结果"]
    sequence --> snapshots["Ready 快照提供已验证动作"]
    snapshots --> selected["仅 Current 工具提供当前语音映射预设"]
    selected --> resolve["解析唯一的 global hold-start/finish 或 toggle 动作"]
    resolve --> preflight["每次新 action 读取实际输入源；不匹配则拒绝"]
    preflight --> freeze["Core 在物理按下时冻结动作计划"]
    freeze --> release["物理松开沿用已冻结计划"]
    selected -->|切换工具| cancel["持久化选择并取消旧工具仍按住的动作"]
    cancel --> refresh["刷新映射/输出与音频路由"]
    explicit["显式选择 / 重选当前工具 / 手动启用遥控器"] --> reading{"配置仍在读取？"}
    reading -->|是| intent["仅记录这次选择的工具与 discovery sequence"]
    intent --> completed{"同一工具及同一次读取完成？"}
    sequence --> completed
    completed -->|是| required{"适配器声明唯一可执行输入源？"}
    completed -->|否| dropped["丢弃旧请求；不重试"]
    reading -->|否| required
    required -->|否| unchanged["不改系统输入法"]
    required -->|是| busy{"旧会话或路由仍未释放？"}
    busy -->|是| retry["保留选择；释放后需显式重选"]
    busy -->|否| enabledSource["TIS：仅选择已启用的精确 ID"]
    enabledSource --> verify["立即读回确认；失败保留错误"]
    verify --> preflight
    revoke["改选 / 停用 / 退出 / 新读取替代"] --> dropped
    background["登录启动 / 自动恢复 / 仅启用插件"] --> unchanged
    assets["Apple 缺模型：显式下载"] --> owner["复用发现任务；持有 sequence 与 cancel"]
    owner --> preparing["正在准备；可取消"]
    preparing -->|取消或停用| cancelling["请求取消；保留任务直到回调"]
    cancelling --> terminal{"原生清理完成？"}
    terminal -->|否| pending["保留 native owner；提示重新检查"]
    pending -->|显式重新检查| closePending["先 Close 旧 owner；失败不新建"]
    closePending --> terminal
    terminal -->|是| retryAsset["记录本轮结果；允许显式重试"]
    retryAsset --> assets
    preparing -->|成功| sequence
