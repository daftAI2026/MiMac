flowchart LR
    source["冻结源码与日期版本"] --> lane{"日用或开发入口"}
    lane -->|日用| daily["MiMac / dev.mimac.app / MiMac 配置目录"]
    lane -->|开发| dev["MiMac Dev / dev.mimac.app.dev / MiMac Dev 配置目录"]
    daily --> profile{"显式组件方案"}
    dev --> profile
    dev --> isolated["默认不接管设备、按键输出、系统输入法和音频"]
    isolated --> handoff["显式设备验收：先退出日用版，串行交接"]
    profile -->|core-only| core["五个原生库；排除 Siri 私有库"]
    profile -->|siri-glass| gate{"arm64 + 精确系统 ABI 门满足？"}
    gate -->|否| reject["停止构建；不复用旧库"]
    gate -->|是| siri["五个原生库 + SiriGlassBridge"]
    core --> buildApp["MyGo 构建 App"]
    siri --> buildApp
    buildApp --> verify["核对源码、版本、架构、符号、签名与 SHA"]
    verify --> manifest["manifest 记录方案、实际组件与 ABI 门结果"]
    manifest --> packagingGate{"工具与元数据依赖齐备？"}
    packagingGate -->|否| packagingReject["输出具体缺项；不创建或挂载镜像"]
    packagingGate -->|是| dmg["建立临时镜像；复制已校验 App，写入单图标布局与 Retina 安装背景"]
    dmg --> archive["只读 DMG + ZIP + SHA256；不更改 App 签名内容"]
    archive --> preview["可复核预览包；不自动替换当前 App"]
    preview --> imageLaunch["用户双击镜像内 MiMac"]
    imageLaunch --> imageGate{"日用身份 + 真实只读镜像？"}
    imageGate -->|否| normal["正常启动；Dev 不进入正式安装"]
    imageGate -->|是| install["正常退出精确旧实例；暂存复制并校验"]
    install --> swap["可回退替换；从 Applications 启动"]
    swap --> eject["旧进程退出后卸载自身镜像"]
    swap -->|失败| rollback["恢复原版本；明确错误"]
    preview --> distribution["签名、公证、升级验收与正式发版另设门"]
