flowchart TD
    launch["普通启动"] --> resume{"首启记录未完成？"}
    resume -->|是| onboarding["打开完整首启窗口，恢复未完成的当前步骤"]
    resume -->|否| known{"已有配置或已完成？"}
    known -->|是| once["仅普通启动读取消费一次"]
    known -->|否| onboarding
    reopenJourney["菜单：使用引导"] --> onboarding
    onboarding --> entry{"新用户或显式复看？"}
    entry -->|是| welcome["欢迎页：品牌、简介、继续与稍后设置"]
    entry -->|否| savedStep["沿既有0/1/2记录恢复设备、语音或权限页"]
    savedStep --> deviceStep
    savedStep --> toolStep
    savedStep --> permissionStep
    welcome -->|继续| deviceStep["第1步：连接遥控器"]
    welcome -->|稍后设置| finish
    deviceStep -->|上一步| welcome
    deviceStep --> device["进入与焦点返回自动只读检测，显示插件连接指引"]
    device -->|检测失败| deviceRetry["该设备显示重试，不常驻检测按钮"]
    deviceRetry --> device
    toolStep --> toolReturn["进入与焦点返回自动检查应用和已有配置，不自动下载或收音"]
    toolReturn --> toolFailure["读取失败仅在对应工具行提供重试"]
    deviceStep --> toolStep["第2步：准备语音工具"]
    toolStep -.-> toolStatus["未安装保留下载入口；已安装未启用保留启用入口；已选用且就绪显示成功反馈，其他状态不标成功"]
    toolStatus -->|下载安装| vendorDownload["打开适配器官网，不启动安装轮询或启用插件"]
    vendorDownload --> installOutside["用户自行下载安装，可稍后完成"]
    installOutside -->|返回窗口，复用MyGo OnFocus| toolReturn
    toolReturn -.-> installationProjection["同一次Bundle结果更新安装状态与图标；离页取消，迟到结果按代次拒绝"]
    toolStep --> explicitChoice["用户明确启用并选择已有工具；模型准备由插件提供"]
    explicitChoice --> originalSelection["复用插件启停与唯一Current选择，不自动收音"]
    toolStep -->|继续，可暂不安装或选择| permissionStep["第3步：系统权限单格摘要"]
    permissionStep --> permissionGuide["点击授权打开可关闭的系统权限引导"]
    permissionStep -->|继续| completion["独立完成页：当前设备按键摘要，开始使用与返回权限"]
    completion -.-> completionMotion["MyGo元素单次弹簧入场与450ms角标延迟；收敛停止，减少动态效果显示最终态"]
    completion -->|返回系统权限| permissionStep
    completion -->|开始使用| finish["保存首启完成并交接映射，不自动启用设备或收音"]
    finish --> mappings
    onboarding -->|中途关闭| pending["保留未完成标记与当前步骤，下次继续"]
    systemReopen["系统要求退出并重开：普通启动入口"] --> resume
    grantAction -.-> pendingSettings["普通设置记住待完成的一项列表权限"]
    nativeRebind -.-> pendingSettings
    pendingSettings -->|正常退出且小卡仍打开| oneShot["保存一次性续接、入口和首启授权动作"]
    oneShot -.-> permissionStep
    permissionStep -->|仍缺权限：恢复小卡与首启授权动作| permissionGuide
    permissionStep -->|续接的首启授权已齐| complete
    oneShot -.-> once
    once -->|记录仍对应当前能力| recoverSettings["回通用页及权限小卡，重查并显示实际状态"]
    once -->|无适用记录| tray["保留菜单栏启动行为"]
    explicit["显式诊断窗口参数"] --> override["按参数显示或隐藏，不写首启配置"]
    device --> detected{"当前 HID 已发现可用设备？"}
    device -.->|缺输入监控时可去通用| generalPermissions["通用：输入监控和设备控制分别显示状态"]
    menuPermissions["菜单：系统权限"] --> permissionGuide
    generalPermissions -->|按行保留所选权限| directPlacement{"已有可见的系统设置窗口？"}
    directPlacement -->|有且对应权限仍缺：首帧直接贴靠| permissionGuide
    directPlacement -->|无：独立小卡靠右| permissionGuide
    permissionGuide -.-> nativeWindow["MyGo 创建可点击和拖动的小卡，小卡不取得键盘"]
    permissionGuide --> existingSettings{"系统设置已经运行？"}
    existingSettings -->|是且有缺失列表权限：切到对应页| settings
    existingSettings -->|否：独立小卡靠右，等待用户打开设置| stable
    permissionGuide --> inspect["按权限类别只读查询：输入监控与AX辅助功能分别读取，不开始监听或录音"]
    inspect --> missing{"所需能力仍缺权限？"}
    missing -->|是| grantAction["用户显式点击授权"]
    titleLink["用户点击权限标题链接"] --> settings["释放小卡键窗口，向运行中的系统设置交接激活，再打开对应页"]
    settings --> stable["面板显示或显式设置动作开启：六秒内查找同一窗口与完整frame，两次稳定后350ms ease-in-out贴边，窗口顶对齐、横向间距16pt"]
    stable --> follow["拖动时直接跟随，松开后位置调整使用250ms ease-out；手动移开面板则停止跟随"]
    follow --> illustration["位置稳定且鼠标松开后显示96pt来源图标槽中的半透明图标与原生抓手，沿二次曲线指向设置列表，3.65秒循环；拖动及减少动态效果时隐藏"]
    illustration --> drag["真实拖动交给系统；开始拖动后停止示意"]
    drag --> spotlight["MyGo原生会话Started事件：每屏透明穿透层覆黑50%，设置内容区保留12pt圆角孔；180ms系统透明度动画"]
    spotlight --> trackDrop["固定本次设置窗口ID，每33ms更新几何；普通窗口采样遮挡率达60%则结束，不改变权限或焦点"]
    trackDrop -.-> dropRim["开孔外保留2pt间距及3pt轮廓，随鼠标进出改变透明度；真实落点仍由系统处理"]
    trackDrop -->|松开、取消、权限窗隐藏或关闭| endDrop["停止拖动跟踪，180ms淡出并隐藏本面板的遮罩窗口；关闭面板时统一释放"]
    endDrop --> guideRefresh["有效拖放后交还键盘焦点，并重查实际授权"]
    missing -->|否| complete["小卡与主卡显示已授权，主卡保留继续按钮"]
    drag -.-> nativeRebind["原生文件 URL 交给系统列表；授权状态以系统复查为准"]
    nativeRebind --> guideRefresh
    nativeRebind --> staleProof["确认落在系统列表后，针对同一应用、权限和代码签名读取旧授权失配证据"]
    staleProof -->|明确失配且仍未获准| recoverEntry["提示在系统设置移除该项旧记录并重新拖入"]
    recoverEntry --> nativeRebind
    grantAction --> nativeGrant{"首次蓝牙授权？"}
    nativeGrant -->|否：列表权限或已处理的蓝牙权限| settings
    nativeGrant -->|是| bluetoothGrant["发起系统蓝牙请求，不自动再次打开设置"]
    bluetoothGrant --> guideRefresh["重新查询实际授权状态，不把请求返回当授权完成"]
    activeReturn["App实际成为活动应用：沿MyGo事件立即重新查询，不重开或移动权限面板"] --> guideRefresh
    grantedFeedback["读到真实已授权：以SF圆圈勾与已授权胶囊替换按钮，取消当前指向并推进到下一项缺失能力"] --> permissionGuide
    guideRefresh -->|实际状态为已授权| grantedFeedback
    guideRefresh --> sharedSetup["同一授权快照推送首启权限页，变化时才重绘，不新增轮询"]
    guideRefresh -->|授权状态变化| generalPermissions
    sharedSetup --> permissionGuide
    sharedSetup -.-> permissionSummary["首启最后一项获准：收起小卡，主卡保留继续；本进程点击过首启授权时，向系统设置发一次正常退出请求，再请求回到首启；通用小卡保持打开"]
    identity["日用权限归 MiMac；开发权限归 MiMac Dev，均只管理自身 Bundle"] -.-> inspect
    permissionGuide -->|关闭| keepSettings["停止轮询与跟随，关闭示意与拖动遮罩窗口，保留设置与菜单入口"]
    detected -->|是| connected["显示已连接，无需再次配对"]
    connected --> mappings["前往按键映射，保留现有模型、键值与工具选择"]
    mappings --> enable
    detected -->|否或断连| help["显示设备插件提供的连接指引"]
    help --> pair["打开系统蓝牙设置"]
    pair --> saved{"系统设置中已有配对记录？"}
    saved -->|无| pairing["遥控器进入配对模式，选择对应设备连接"]
    saved -->|有| reconnect["唤醒遥控器，必要时点连接"]
    pairing --> recheck["回到 MiMac 自动检测"]
    reconnect --> recheck
    recheck --> detected
    evidence["HID / ATVV 未发现不等于未配对；配对记录由系统蓝牙界面确认"] -.-> saved
    enable["在按键映射或插件页启用遥控器"]
    enable --> grants["按能力申请输入监控 / 控制权限 / 蓝牙；名称跟随系统版本"]
    grants --> outputPreflight["需要键输出时沿既有显式启用路径请求与预检PostEvent服务；权限卡刷新不请求"]
    outputPreflight --> returnApp["返回后只复核已请求权限，不开始收音"]
    plugins["插件页：启用 / 停用适配器"] --> discovery["自动定位应用与配置"]
    discovery --> available["已启用工具出现在语音工具页和映射选择中"]
    available --> choose["用户在语音工具页或按键映射中选择工具"]
    choose --> current["共用唯一 Current 和既有选择入口"]
    current --> resolve["适配器提供动作；桥接模块准备现有音频路径"]
    current --> selectSource["选择工具时，由既有插件自动选中系统输入源"]
    selectSource --> resolve
    resolve --> ready{"按键、动作与所需音频均就绪？"}
    enable --> ready
    ready -->|是| action["回到输入位置，按住说话，松开完成"]
    ready -->|否| status["显示实际缺项，不提前触发快捷键或开麦"]
    separate["启用插件不等于选为当前工具；语音页不新增麦克风选择"] -.-> current
    failures["权限 / 蓝牙关闭 / 未连接按实际原因区分"] --> next["状态只读，设备页提供对应恢复动作"]
    navigation["侧栏：按键映射 → 语音工具 → 设备 → 插件 → 通用 → 关于"] -.-> device
