flowchart TD
    launch["普通启动"] --> resume{"首启记录未完成？"}
    resume -->|是| onboarding["打开完整首启窗口"]
    resume -->|否| known{"已有配置或已完成？"}
    known -->|是| tray["保留菜单栏启动行为"]
    known -->|否| onboarding
    reopenJourney["菜单：使用引导"] --> onboarding
    onboarding --> deviceStep["第1步：连接遥控器"]
    deviceStep --> device["只读检测，显示插件连接指引"]
    deviceStep --> toolStep["第2步：准备语音工具"]
    toolStep --> explicitChoice["用户明确启用并选择已有工具；模型准备由插件提供"]
    explicitChoice --> originalSelection["复用插件启停与唯一Current选择，不自动收音"]
    toolStep --> permissionStep["第3步：系统权限"]
    permissionStep --> permissionGuide["点击授权打开可关闭的系统权限引导"]
    permissionStep --> finish["进入按键映射：保存首启完成，不代表设备已就绪"]
    finish --> mappings
    onboarding -->|中途关闭| pending["保留未完成标记，下次继续"]
    explicit["显式诊断窗口参数"] --> override["按参数显示或隐藏，不写首启配置"]
    device --> detected{"当前 HID 已发现可用设备？"}
    device --> permissionGuide["显示可关闭的系统权限引导"]
    reopen["菜单或设备页：系统权限"] --> permissionGuide
    permissionGuide -->|只读查找已经打开的设置窗，不主动打开| stable
    permissionGuide --> inspect["只读检查所需权限，不开始监听或录音"]
    inspect --> missing{"所需能力仍缺权限？"}
    missing -->|是| grantAction["用户显式点击授权"]
    titleLink["用户点击权限标题链接"] --> settings["打开对应系统设置页"]
    settings --> stable["面板显示或显式设置动作开启：六秒内查找同一窗口与完整frame，两次稳定后350ms ease-in-out贴边"]
    stable --> follow["拖动时直接跟随，松开后位置调整使用250ms ease-out；手动移开面板则停止跟随"]
    follow --> illustration["位置稳定且鼠标松开后显示透明拖放示意，拖动及减少动态效果时隐藏"]
    illustration --> drag["真实拖动交给系统；开始拖动后停止示意"]
    drag --> guideRefresh
    missing -->|否| complete["显示已完成；可关闭，不接管设备"]
    grantAction --> nativeGrant["授权沿用原生请求并重新读取；仍缺权限进入对应设置。标题链接直接打开设置"]
    nativeGrant --> guideRefresh["重新查询实际授权状态，不把请求返回当授权完成"]
    guideRefresh -->|仍缺权限| settings
    guideRefresh -->|原生提示待处理或已完成| permissionGuide
    identity["日用权限归 MiMac；开发权限归 MiMac Dev，均只管理自身 Bundle"] -.-> inspect
    permissionGuide -->|关闭| keepSettings["停止轮询与跟随，关闭示意窗口，保留设置与菜单入口"]
    detected -->|是| connected["显示已连接，无需再次配对"]
    connected --> mappings["前往按键映射，保留现有模型、键值与工具选择"]
    mappings --> enable
    detected -->|否或断连| help["显示设备插件提供的连接指引"]
    help --> pair["打开系统蓝牙设置"]
    pair --> saved{"系统设置中已有配对记录？"}
    saved -->|无| pairing["遥控器进入配对模式，选择对应设备连接"]
    saved -->|有| reconnect["唤醒遥控器，必要时点连接"]
    pairing --> recheck["回到 MiMac 重新检测"]
    reconnect --> recheck
    recheck --> detected
    evidence["HID / ATVV 未发现不等于未配对；配对记录由系统蓝牙界面确认"] -.-> saved
    enable["在按键映射或插件页启用遥控器"]
    enable --> grants["按能力申请输入监控 / 辅助功能 / 蓝牙"]
    grants --> returnApp["返回后只复核已请求权限，不开始收音"]
    plugins["插件页：启用 / 停用适配器"] --> discovery["自动定位应用与配置"]
    discovery --> available["已启用工具出现在语音工具页和映射选择中"]
    available --> choose["用户在语音工具页或按键映射中选择工具"]
    choose --> current["共用唯一 Current 和既有选择入口"]
    current --> resolve["适配器提供动作；桥接模块准备现有音频路径"]
    current --> selectSource["选择工具时，由既有插件自动选中系统输入源"]
    selectSource --> resolve
    resolve --> ready{"按键、动作与所需音频均就绪？"}
    enable --> ready
    ready -->|是| action["回到输入位置，按住说话，松开完成"]
    ready -->|否| status["显示实际缺项，不提前触发快捷键或开麦"]
    separate["启用插件不等于选为当前工具；语音页不新增麦克风选择"] -.-> current
    failures["权限 / 蓝牙关闭 / 未连接按实际原因区分"] --> next["状态只读，设备页提供对应恢复动作"]
    navigation["侧栏：按键映射 → 语音工具 → 设备 → 插件 → 通用 → 关于"] -.-> device
