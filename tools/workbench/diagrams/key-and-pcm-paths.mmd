flowchart LR
    hid["Xiaomi HID monitor\n物理按键边沿"] --> coordinator["MyGo 主线程协调器"]
    coordinator -.-> observation["已接受的设备事件边沿计数\n包含启动前检查失败；不等于动作成功"]
    coordinator --> resolve["解析当前映射或工具动作"]
    resolve --> core["bridge.Core\n冻结唯一动作计划与会话策略"]
    core -->|按键效果| keyout["系统按键输出适配器"]
    keyout --> target["当前选定的外部语音工具"]

    tool["当前工具注册的 audioRouteFactory"] --> connection["liveAudioConnection\n准备并持有共享路由"]
    connection --> identity["准备音频端点；确认目标应用身份与空闲态"]
    identity --> sinkPrepare["资源 worker 预订阅 Source，并准备定向输出 Sink"]
    sinkPrepare --> controlService["可选 prepareControl：豆包等原生启动完成
一次 UUID 配置应答，不开麦、不发键"]
    controlService --> readyResources["现有 preparedOwner 发布 Ready；失败保留部分资源待清理"]
    readyResources --> prepare["用户动作后 Core 发出 PrepareSource"]
    prepare --> runtime["audio-session Runtime\n拥有本会话的 Source 和 Sink"]
    remoteAudio["ATVV 控制/音频通知"] --> source["当前 ATVV Source\n有界 PCM 环形队列"]
    runtime --> resources["取得连接期已准备的 Source/Sink 租约；校验格式与源健康"]
    resources --> reader["会话唯一 Source.Read 任务"]
    source --> reader
    reader --> stage["有界 PCM FIFO：两秒采样量；满时停读"]
    resources --> wait["可选 WaitReceiver\n核验活动接收器的精确 PID/UID"]
    wait -->|就绪| prepared["SourcePrepared"]
    prepared --> open["Core 开启本 token 的 PCM gate"]
    open --> consume["Runtime 消费 FIFO；双门前零输出与观测"]
    stage --> consume
    consume --> pcm["有序 PCM 数据块"]
    pcm --> sink["配置的 Sink：Apple Speech 或兼容音频路由"]
    sink --> targetInput["目标输入路由\n本地 Sink 接受不证明目标已消费"]
    consume -->|合法 EOF 且 Stop 已请求| drain["源停止与 EOF 后，按有限尾部时长排空
本地 drain 与可选最终转写"]
    drain --> text["Apple 路由可向按下时捕获的文本目标投递一次"]

    source -.-> overflow["ErrSourceQueueFull 时：typed QueueOverflowError\nSnapshot 是冻结的 SourceSnapshot 诊断"]
    wait -.-> waitTrace["可选 I/O 明细跨度：receiver.wait\n不等于收音就绪或 PCM 消费确认"]
    overflow -.-> noFix["原源环容量不变；FIFO 另有上限\n超界明确失败，不覆盖或丢弃样本"]

    pcm --> meter["同次消费块的 RMS/peak 与可选频谱\n仅当前 token；不保存录音"]
    core --> snapshot["Core Snapshot 与完整 SessionToken"]
    meter --> projection["Host 语音呈现投影\n仅 Preparing / Capturing / Draining"]
    snapshot --> projection
    projection --> preference["show_voice_overlay 偏好"]
    preference --> panel["MyGo 非激活 Panel\n鼠标穿透；可见时请求 30 Hz；实测节拍单列"]
    panel --> gate{"arm64 macOS 27.0.1 build 26A434？"}
    gate -->|是| renderer["可选 siriglass 材质\n当前频谱进入 audioMeters 数组"]
    gate -->|否| unsupported["不支持：只关闭显示"]
    renderer --> operation{"原生显示调用成功？"}
    operation -->|是| material["呈现当前会话材质"]
    operation -->|否| failure["记录显示故障；音频会话继续"]

    renderer -.-> vendor["后续：厂商语音条接管"]
    renderer -.-> siri["后续：完整 Siri 前景、思考状态与业务语义"]
