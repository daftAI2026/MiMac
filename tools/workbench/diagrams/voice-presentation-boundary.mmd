flowchart TD
    input["设备边沿与音频完成事件"] --> owner["MyGo 主线程上的 coordinator"]
    owner --> core["bridge.Core：唯一语音状态机"]
    core --> snapshot["Snapshot：HasSession、完整 SessionToken 与 phase"]
    snapshot --> active{"Preparing / Capturing / Draining 会话？"}
    active -->|否| idle["隐藏 / 空会话；不推断识别或提交结果"]
    active -->|是| phase["Host 纯投影：正在准备语音 / 正在收音 / 正在结束语音"]

    runtime["audio-session Runtime：现有 PCM worker"] --> source["当前会话 Source 输入块"]
    source --> meter["当前 token latest RMS / peak / ObservedAt；不留样本"]
    source --> observer["可选 PCMObserver：同一 worker 只读观测"]
    observer --> spectrum["Siri适配器：128样本 Hamming / 频点幅值求和；不改PCM"]
    snapshot --> match["完整 SessionToken 匹配；仅取新鲜频带（≤100 ms），读取时平滑"]
    meter --> match
    spectrum --> match
    phase --> frame["voiceOverlayFrame：可见性/标签/录音与所有权 + 当前频谱快照"]
    match --> frame
    idle --> frame

    preference["通用设置：MiMac 语音球 / 跟随语音工具"] --> enabled{"语音提示插件已启用？"}
    enabled -.-> status["插件页显示状态，设置入口共用通用设置"]
    frame --> enabled
    enabled -->|否| hidden["关闭 MiMac 面板和频谱分析"]
    hidden --> toolDisplay["语音工具自行决定是否显示原生提示"]
    enabled -->|是| panel["MyGo Panel：ShowInactive、鼠标穿透、仅可见时 30 Hz"]
    panel --> gate{"arm64 + macOS26公开API下限？"}
    gate -->|是| capability{"原生符号、布局与witness兼容？"}
    capability -->|是| renderer["siriglass：显示倍率×5一次 → 原生 audioMeters 数组入口"]
    capability -->|否| unsupported
    gate -->|否| unsupported["不支持：仅关闭呈现"]
    renderer --> operation{"创建 / 更新 / 关闭成功？"}
    operation -->|是| material["显示当前会话材质"]
    operation -->|否| failure["仅记录显示故障并关闭呈现"]
    hidden --> audio["Core 与 Runtime 音频会话保持独立"]
    unsupported --> audio
    failure --> audio

    vendor["厂商语音条接管"] -.-> future["未来：逐工具接入业务语义与前景状态"]
    siri["完整 Siri 前景、personality / thinking 与频带语义"] -.-> future

    explicit["Core纯投影的录音与所有权；浮动适配器指定island"] --> nativeEdges["思考边与录音/控制权合取门分别观察；初始值不重放"]
    frame --> controls["仅状态变化调用既有JSON入口；token替换/隐藏清观察基线"]
    controls --> explicit
    renderer --> arrays["频谱仍走固定SoA帧接口；保持控制输入"]
    nativeEdges --> exitGate{"录音/控制权门刚关闭？"}
    exitGate -->|是| exitScene{"显式island场景且未Reduce Motion？"}
    exitScene -->|是| resetAnimated["人格与X/Y同退出弹簧；0.3 / 0.8；不延迟Y"]
    exitScene -->|否| reset["清思考人格；X/Y同事务直接复位"]
    exitGate -->|否| thinkEdge["只在新思考边采样门控；恢复控制权不补播"]
    reset --> material
    resetAnimated --> material
    target["未来：可靠目标思考反馈；当前未知保持false"] -.-> thinkEdge
