flowchart TD
    input["设备边沿与音频完成事件"] --> owner["MyGo 主线程上的 coordinator"]
    owner --> core["bridge.Core：唯一语音状态机"]
    core --> snapshot["Snapshot：HasSession、完整 SessionToken 与 phase"]
    snapshot --> active{"Preparing / Capturing / Draining 会话？"}
    active -->|否| idle["隐藏 / 空会话；不推断识别或提交结果"]
    active -->|是| phase["Host 纯投影：正在准备语音 / 正在收音 / 正在结束语音"]

    runtime["audio-session Runtime：现有 PCM worker"] --> source["当前会话 Source 输入块"]
    source --> meter["当前 token latest RMS / peak / ObservedAt；不留样本"]
    snapshot --> match["完整 SessionToken 匹配；仅取新鲜电平（≤100 ms）"]
    meter --> match
    phase --> frame["voiceOverlayFrame：label + 可选 RMS→dB"]
    match --> frame
    idle --> frame

    preference["show_voice_overlay：默认开启的持久偏好"] --> enabled{"显示偏好开启？"}
    frame --> enabled
    enabled -->|否| hidden["隐藏并停止呈现"]
    enabled -->|是| panel["MyGo Panel：ShowInactive、鼠标穿透、仅可见时 30 Hz"]
    panel --> gate{"仅 arm64 macOS 27.0.1 build 26A434？"}
    gate -->|是| renderer["siriglass：加载原生私有 ABI dylib"]
    gate -->|否| unsupported["不支持：仅关闭呈现"]
    renderer --> operation{"创建 / 更新 / 关闭成功？"}
    operation -->|是| material["显示当前会话材质"]
    operation -->|否| failure["仅记录显示故障并关闭呈现"]
    hidden --> audio["Core 与 Runtime 音频会话保持独立"]
    unsupported --> audio
    failure --> audio

    vendor["厂商语音条接管"] -.-> future["未来：逐工具接入业务语义与前景状态"]
    siri["完整 Siri 前景、personality / thinking 与频带语义"] -.-> future
