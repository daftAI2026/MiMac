flowchart LR
    mygo["MyGo：主线程、菜单、窗口与事件循环"] --> host["cmd/mimac 组合根"]
    host -->|串行生命周期调用| runtime["pluginrt：固定 manifests\n不另建事件循环或 goroutine"]
    core["bridge"]
    keyout["key-output"]
    hid["xiaomi-hid"]
    remote["remote-control"]
    audioout["audio-output"]
    audiosession["audio-session"]
    voice["内置语音工具 manifests"]
    cleanup["Start 所有路径须返回非空 StopFunc\n失败时 Runtime 用它回滚"]

    keyout -->|依赖| core
    hid -->|依赖| core
    remote -->|依赖| core
    remote -->|依赖| hid
    audioout -->|依赖| core
    audiosession -->|依赖| core
    audiosession -->|依赖| audioout
    runtime -->|按依赖序 Enable| core
    runtime -->|按逆依赖序 Close| remote
    runtime -->|清理失败则故障并保留依赖| audiosession
    runtime -->|无模块依赖| voice
    runtime --> cleanup

    host --> catalog["同一插件目录"]
    catalog --> visibility{"开发版？"}
    visibility -->|是| all["显示全部插件"]
    visibility -->|否| ready["只显示适配可用插件；不按安装状态过滤"]
    all --> controls["MyGo Switch 读取实际启用状态"]
    ready --> controls
    controls -->|Changed| activation["调用原启停入口；失败后继续显示实际状态"]
    activation --> runtime
    saved["显示筛选不修改已保存启用项、当前选择或注册表"] -.-> visibility
