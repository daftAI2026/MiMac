flowchart LR
    mygo["MyGo 宿主：主线程与事件循环"]
    shell["cmd/mimac 组合根"]
    backendPrefs["启动前解析音频后端偏好\n独立文件；显式当次参数优先；无选择则关闭"]
    ui["MyGo 设置窗口与菜单栏托盘"]
    plugins["pluginrt 固定清单生命周期\n串行调用；不另建事件循环"]
    core["bridge.Core 唯一设备动作与语音会话状态"]
    hid["Xiaomi HID 适配器"]
    keys["系统按键输出适配器"]
    audio["音频会话与路由适配器"]
    routeFactory["工具注册的 audioRouteFactory 能力"]
    routeOwner["liveAudioConnection + Runtime + preparedAudioOwner\n连接、预备资源与会话 source/sink owner 分层"]
    sourceRecovery["source 故障按实际音频会话限次恢复\nCore 空闲且无按键时 retire / close / 重建音频 owner\n仅成功 SourceDrained 后重新开放一次；权限/状态拒绝不自动重试\n不重启 HID、不补发按键"]
    tools["语音工具发现与动作快照"]
    text["辅助功能文本输出适配器"]
    prefs["voice_presentation 持久偏好"]
    measurement["可选 PCM 观测\n通用 audiometer；不改变音频"]
    projection["Host 语音呈现投影\nCore Snapshot + 当前 token 响度 / 球体频谱"]
    panel["MyGo 非激活 Panel\n显示时请求帧；鼠标穿透"]
    glass["siriglass 可选材质 renderer\narm64 + macOS26公开API下限 / 当前原生能力检查"]
    fault["显示故障只关闭呈现\nCore 与音频会话继续"]
    future["未来：厂商语音条接管\n完整 Siri 前景与业务语义"]

    mygo --> shell
    backendPrefs --> shell
    mygo --> ui
    shell --> plugins
    shell --> core
    shell --> hid
    shell --> keys
    shell --> routeFactory
    routeFactory --> routeOwner
    routeFactory --> contracts["Apple / 豆包 / WeType 薄适配\n按工具处理身份、输入源与偏好协议"]
    contracts --> routeOwner
    routeOwner -. source fault .-> sourceRecovery
    sourceRecovery -->|same tool and device generation| routeFactory
    routeOwner --> audio
    shell --> tools
    shell --> text
    core --> projection
    audio --> measurement
    measurement --> projection
    prefs --> projection
    projection --> panel
    panel --> dots["点阵语音条：RMS 驱动点场；收起后停止请求帧"]
    panel --> glass
    glass --> fault
    glass -.-> future
